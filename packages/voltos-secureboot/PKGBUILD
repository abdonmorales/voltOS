# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>

pkgname=voltos-secureboot
pkgver=0.1.0
pkgrel=4
pkgdesc="Enable UEFI Secure Boot for VoltOS (own keys via sbctl, signed ZFSBootMenu and kernels)"
arch=('any')
url="https://github.com/abdonmorales/voltOS"
license=('MIT')
# voltos-zbm: zfsbootmenu-efi (x86_64) or zfsbootmenu (AArch64)
depends=('bash' 'sbctl' 'voltos-zbm')
source=('voltos-secureboot')
sha256sums=('SKIP')

package() {
    install -Dm755 voltos-secureboot "${pkgdir}"/usr/bin/voltos-secureboot
}
