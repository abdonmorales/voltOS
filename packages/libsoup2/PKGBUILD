# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>
#
# libsoup 2.4, the HTTP library libgweather 2 (the GNOME 2 panel clock's
# locations and weather) is written against.  Arch Linux ships only
# libsoup 3, which installs alongside.  From GNOME's final 2.74.3 release,
# for x86_64 and AArch64; only the core library (no introspection, GSSAPI
# or NTLM).

pkgname=libsoup2
pkgver=2.74.3
pkgrel=1
pkgdesc="HTTP client/server library, version 2.4 API"
arch=('x86_64' 'aarch64')
url="https://gitlab.gnome.org/GNOME/libsoup"
license=('LGPL-2.0-or-later')
depends=('glib2' 'libxml2' 'libpsl' 'sqlite' 'brotli' 'glib-networking')
makedepends=('meson' 'glib2-devel' 'libxml2' 'libpsl' 'sqlite' 'brotli' 'vala')
provides=('libsoup' 'libsoup-2.4.so')
conflicts=('libsoup')
source=("https://download.gnome.org/sources/libsoup/${pkgver%.*}/libsoup-$pkgver.tar.xz")
# From GNOME's libsoup-2.74.3.sha256sum.
sha256sums=('e4b77c41cfc4c8c5a035fcdc320c7bc6cfb75ef7c5a034153df1413fa1d92f13')

build() {
    arch-meson libsoup-$pkgver build -Dgnome=false -Dintrospection=disabled \
        -Dvapi=disabled -Dgtk_doc=false -Dtests=false -Dinstalled_tests=false \
        -Dsysprof=disabled -Dntlm=disabled -Dgssapi=disabled -Dbrotli=enabled \
        -Dtls_check=false
    meson compile -C build
}

package() {
    meson install -C build --destdir "$pkgdir"
}
