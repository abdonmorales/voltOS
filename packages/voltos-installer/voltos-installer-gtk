#!/usr/bin/python3
#
# voltos-installer-gtk: graphical front end for voltos-install.
#
# Collects the target disk, the user account and the region settings,
# writes them to a private config file and runs
#     pkexec /usr/bin/voltos-install --config FILE
# showing the installer's progress.  All partitioning, ZFS and boot-loader
# work stays in voltos-install, which is also what the text installer and
# the automated tests use.
#
# Test mode: with VOLTOS_INSTALLER_TEST=<disk> in the environment the window
# fills in a throwaway account (user "volt", password "volt"), selects that
# disk, walks through its pages and starts the installation itself, then
# writes "ok" or "failed" to /tmp/voltos-installer-test.result.  It erases
# the disk without asking; tools/smoke-qemu.sh uses it in a VM.
#
# SPDX-License-Identifier: MIT

import json
import os
import re
import subprocess
import sys
import tempfile

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

APP_ID = "org.voltos.Installer"
INSTALLER = "/usr/bin/voltos-install"
ZONEINFO = "/usr/share/zoneinfo"
LOCALES = ["en_US.UTF-8", "en_GB.UTF-8", "es_ES.UTF-8", "es_MX.UTF-8",
           "fr_FR.UTF-8", "de_DE.UTF-8", "it_IT.UTF-8", "pt_BR.UTF-8",
           "nl_NL.UTF-8", "pl_PL.UTF-8", "ru_RU.UTF-8", "ja_JP.UTF-8",
           "ko_KR.UTF-8", "zh_CN.UTF-8"]
KEYMAPS = ["us", "uk", "es", "la-latin1", "fr", "de", "it", "br-abnt2",
           "nl", "pl", "ru", "jp106"]

# Progress messages voltos-install logs, in order, with the fraction of the
# installation they start at.
STAGES = [("Partitioning", 0.05), ("Creating ZFS pool", 0.12),
          ("Copying the system", 0.20), ("Configuring", 0.75),
          ("Finishing", 0.95)]

TEST_DISK = os.environ.get("VOLTOS_INSTALLER_TEST")
TEST_RESULT = "/tmp/voltos-installer-test.result"

NAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
HOST_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]{0,62}$")


def boot_disk():
    """The disk the live medium runs from; it is never offered."""
    try:
        src = subprocess.run(["findmnt", "-no", "SOURCE",
                              "/run/archiso/bootmnt"], capture_output=True,
                             text=True, check=False).stdout.strip()
        if not src:
            return None
        parent = subprocess.run(["lsblk", "-no", "PKNAME", src],
                                capture_output=True, text=True,
                                check=False).stdout.split()
        return "/dev/" + parent[0] if parent else None
    except OSError:
        return None


def list_disks():
    out = subprocess.run(["lsblk", "-J", "-d", "-b", "-o",
                          "PATH,SIZE,MODEL,TYPE,TRAN,RM"],
                         capture_output=True, text=True, check=False).stdout
    skip = boot_disk()
    disks = []
    for dev in json.loads(out or '{"blockdevices": []}')["blockdevices"]:
        if dev.get("type") != "disk" or dev.get("path") == skip:
            continue
        size = int(dev.get("size") or 0)
        if size < 16 * 1024 ** 3:
            continue  # too small for VoltOS
        disks.append(dev)
    return disks


def human_size(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1000 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000
    return str(n)


def timezones():
    zones = []
    for root, _dirs, files in os.walk(ZONEINFO):
        rel = os.path.relpath(root, ZONEINFO)
        if rel.split(os.sep)[0] in ("posix", "right", "Etc", "SystemV"):
            continue
        for f in files:
            name = f if rel == "." else os.path.join(rel, f)
            if "/" in name and name[0].isupper():
                zones.append(name)
    zones.sort()
    return ["UTC"] + zones


class Installer(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Install VoltOS")
        self.set_default_size(720, 600)
        self.disk = None
        self.config_path = None

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.back = Gtk.Button(label="Back")
        self.next = Gtk.Button(label="Next")
        self.next.add_css_class("suggested-action")
        self.back.connect("clicked", self.on_back)
        self.next.connect("clicked", self.on_next)

        header = Adw.HeaderBar()
        header.pack_start(self.back)
        header.pack_end(self.next)
        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.set_content(self.stack)
        self.set_content(view)

        self.pages = ["welcome", "disk", "account", "region", "summary"]
        self.stack.add_named(self.page_welcome(), "welcome")
        self.stack.add_named(self.page_disk(), "disk")
        self.stack.add_named(self.page_account(), "account")
        self.stack.add_named(self.page_region(), "region")
        self.stack.add_named(self.page_summary(), "summary")
        self.stack.add_named(self.page_progress(), "progress")
        self.stack.add_named(self.page_done(), "done")
        self.show_page("welcome")
        if TEST_DISK:
            GLib.timeout_add_seconds(3, self.run_test)

    # --- automated test --------------------------------------------------

    def run_test(self):
        """Drive the real pages and controls, as a user would."""
        check = self.disk_checks.get(TEST_DISK)
        if check is None:
            self.test_result("failed: disk %s not offered" % TEST_DISK)
            return False
        self.show_page("disk")
        check.set_active(True)
        self.show_page("account")
        self.fullname.set_text("Volt Test")
        self.username.set_text("volt")
        self.password.set_text("volt")
        self.password2.set_text("volt")
        if self.account_problem():
            self.test_result("failed: " + self.account_problem())
            return False
        self.show_page("region")
        self.show_page("summary")
        if not self.next.get_sensitive():
            self.test_result("failed: Install button disabled")
            return False
        self.next.emit("clicked")
        return False

    def test_result(self, text):
        print("voltos-installer-gtk: test " + text, flush=True)
        with open(TEST_RESULT, "w") as f:
            f.write(text + "\n")

    # --- pages ---------------------------------------------------------

    def scrolled(self, child):
        clamp = Adw.Clamp(maximum_size=560, child=child)
        clamp.set_margin_top(24)
        clamp.set_margin_bottom(24)
        clamp.set_margin_start(12)
        clamp.set_margin_end(12)
        return Gtk.ScrolledWindow(child=clamp, vexpand=True)

    def page_welcome(self):
        uefi = os.path.isdir("/sys/firmware/efi")
        desc = ("VoltOS will be installed on a ZFS file system with boot "
                "environments. Before every software update a snapshot is "
                "taken, so you can always go back from the boot menu.")
        if not uefi:
            desc = ("This computer was started in legacy BIOS mode. "
                    "Installing VoltOS needs UEFI firmware: restart, enable "
                    "UEFI boot in the firmware settings and start the "
                    "installer again.")
        self.uefi = uefi
        return Adw.StatusPage(icon_name="voltos-logo", title="Install VoltOS",
                              description=desc)

    def page_disk(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.disk_group = Adw.PreferencesGroup(
            title="Installation disk",
            description="The whole disk will be erased.")
        box.append(self.disk_group)
        self.disk_rows = []
        self.disk_checks = {}
        group = None
        for dev in list_disks():
            check = Gtk.CheckButton()
            if group is None:
                group = check
            else:
                check.set_group(group)
            check.connect("toggled", self.on_disk_toggled, dev)
            model = (dev.get("model") or "Disk").strip()
            tran = (dev.get("tran") or "").upper()
            row = Adw.ActionRow(
                title=f"{model}  ({human_size(int(dev['size']))})",
                subtitle=f"{dev['path']}  {tran}".strip())
            row.add_prefix(check)
            row.set_activatable_widget(check)
            self.disk_checks[dev["path"]] = check
            self.disk_group.add(row)
            self.disk_rows.append(row)
        if not self.disk_rows:
            self.disk_group.add(Adw.ActionRow(
                title="No suitable disk found",
                subtitle="VoltOS needs a disk of at least 16 GB."))
        return self.scrolled(box)

    def page_account(self):
        group = Adw.PreferencesGroup(title="Your account",
                                     description="This account can administer "
                                     "the computer with sudo.")
        self.fullname = Adw.EntryRow(title="Full name")
        self.username = Adw.EntryRow(title="User name")
        self.password = Adw.PasswordEntryRow(title="Password")
        self.password2 = Adw.PasswordEntryRow(title="Confirm password")
        self.hostname = Adw.EntryRow(title="Computer name")
        self.hostname.set_text("voltos")
        for row in (self.fullname, self.username, self.password,
                    self.password2, self.hostname):
            group.add(row)
            row.connect("changed", lambda *_: self.update_buttons())
        self.fullname.connect("changed", self.on_fullname)
        self.account_error = Gtk.Label(xalign=0, wrap=True)
        self.account_error.add_css_class("error")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.append(group)
        box.append(self.account_error)
        return self.scrolled(box)

    def page_region(self):
        group = Adw.PreferencesGroup(title="Region")
        self.zones = timezones()
        self.tz = Adw.ComboRow(title="Time zone",
                               model=Gtk.StringList.new(self.zones),
                               enable_search=True)
        default = "America/Chicago" if "America/Chicago" in self.zones else "UTC"
        self.tz.set_selected(self.zones.index(default))
        self.locale = Adw.ComboRow(title="Language",
                                   model=Gtk.StringList.new(LOCALES))
        self.keymap = Adw.ComboRow(title="Keyboard layout",
                                   model=Gtk.StringList.new(KEYMAPS))
        for row in (self.tz, self.locale, self.keymap):
            group.add(row)
        return self.scrolled(group)

    def page_summary(self):
        self.summary = Adw.PreferencesGroup(title="Ready to install")
        self.summary_rows = {}
        for key in ("Disk", "Account", "Computer name", "Time zone",
                    "Language", "File system"):
            row = Adw.ActionRow(title=key)
            row.add_css_class("property")
            self.summary.add(row)
            self.summary_rows[key] = row
        warn = Gtk.Label(xalign=0, wrap=True, label=(
            "Everything on the selected disk will be permanently erased."))
        warn.add_css_class("warning")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.append(self.summary)
        box.append(warn)
        return self.scrolled(box)

    def page_progress(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                      valign=Gtk.Align.CENTER)
        box.set_margin_start(48)
        box.set_margin_end(48)
        title = Gtk.Label(label="Installing VoltOS")
        title.add_css_class("title-1")
        self.status = Gtk.Label(label="Starting...", wrap=True)
        self.bar = Gtk.ProgressBar(show_text=False)
        self.log_view = Gtk.TextView(editable=False, monospace=True,
                                     cursor_visible=False)
        log_scroll = Gtk.ScrolledWindow(child=self.log_view, min_content_height=160)
        expander = Gtk.Expander(label="Details", child=log_scroll)
        for w in (title, self.status, self.bar, expander):
            box.append(w)
        return box

    def page_done(self):
        self.done_page = Adw.StatusPage(icon_name="emblem-ok-symbolic",
                                        title="VoltOS is installed")
        restart = Gtk.Button(label="Restart Now", halign=Gtk.Align.CENTER)
        restart.add_css_class("suggested-action")
        restart.add_css_class("pill")
        restart.connect("clicked", lambda *_: subprocess.Popen(
            ["systemctl", "reboot"]))
        self.done_page.set_child(restart)
        return self.done_page

    # --- navigation ------------------------------------------------------

    def show_page(self, name):
        self.stack.set_visible_child_name(name)
        if name == "summary":
            self.fill_summary()
        self.update_buttons()

    def current(self):
        return self.stack.get_visible_child_name()

    def update_buttons(self):
        page = self.current()
        in_flow = page in self.pages
        self.back.set_visible(in_flow and page != "welcome")
        self.next.set_visible(in_flow)
        self.next.set_label("Install" if page == "summary" else "Next")
        if page == "summary":
            self.next.remove_css_class("suggested-action")
            self.next.add_css_class("destructive-action")
        else:
            self.next.remove_css_class("destructive-action")
            self.next.add_css_class("suggested-action")
        ok = True
        if page == "welcome":
            ok = self.uefi
        elif page == "disk":
            ok = self.disk is not None
        elif page == "account":
            ok = self.account_problem() is None
            self.account_error.set_label(self.account_problem() or "")
        self.next.set_sensitive(ok)

    def account_problem(self):
        user = self.username.get_text()
        if not user:
            return "Choose a user name."
        if not NAME_RE.match(user):
            return ("User names start with a lower-case letter and use only "
                    "a-z, 0-9, - and _.")
        if not self.password.get_text():
            return "Choose a password."
        if self.password.get_text() != self.password2.get_text():
            return "The passwords do not match."
        if not HOST_RE.match(self.hostname.get_text()):
            return "Computer names use letters, digits and -."
        return None

    def on_fullname(self, row):
        if self.username.get_text():
            return
        guess = re.sub(r"[^a-z0-9]", "", row.get_text().split(" ")[0].lower())
        if guess:
            self.username.set_text(guess)

    def on_disk_toggled(self, check, dev):
        if check.get_active():
            self.disk = dev
        self.update_buttons()

    def on_back(self, _button):
        i = self.pages.index(self.current())
        self.show_page(self.pages[max(i - 1, 0)])

    def on_next(self, _button):
        page = self.current()
        if page == "summary":
            self.start_install()
            return
        self.show_page(self.pages[self.pages.index(page) + 1])

    def selected(self, combo, items):
        return items[combo.get_selected()]

    def fill_summary(self):
        d = self.disk
        rows = self.summary_rows
        rows["Disk"].set_subtitle(f"{d['path']}  ({human_size(int(d['size']))}), erased")
        rows["Account"].set_subtitle(self.username.get_text())
        rows["Computer name"].set_subtitle(self.hostname.get_text())
        rows["Time zone"].set_subtitle(self.selected(self.tz, self.zones))
        rows["Language"].set_subtitle(
            f"{self.selected(self.locale, LOCALES)}, keyboard "
            f"{self.selected(self.keymap, KEYMAPS)}")
        rows["File system"].set_subtitle(
            "ZFS (zroot), boot environment zroot/ROOT/voltos, ZFSBootMenu")

    # --- installation ------------------------------------------------------

    def start_install(self):
        fd, path = tempfile.mkstemp(prefix="voltos-install-", suffix=".conf")
        values = {
            "DISK": self.disk["path"],
            "HOSTNAME": self.hostname.get_text(),
            "USERNAME": self.username.get_text(),
            "PASSWORD": self.password.get_text(),
            "TIMEZONE": self.selected(self.tz, self.zones),
            "LOCALE": self.selected(self.locale, LOCALES),
            "KEYMAP": self.selected(self.keymap, KEYMAPS),
            "REBOOT": "no",
        }
        with os.fdopen(fd, "w") as f:
            for k, v in values.items():
                if "\n" in v:
                    raise ValueError(f"newline in {k}")
                f.write(f"{k}={v}\n")
        os.chmod(path, 0o600)
        self.config_path = path

        self.show_page("progress")
        self.bar.set_fraction(0.02)
        proc = Gio.Subprocess.new(
            ["pkexec", INSTALLER, "--config", path],
            Gio.SubprocessFlags.STDERR_PIPE | Gio.SubprocessFlags.STDOUT_SILENCE)
        stream = Gio.DataInputStream.new(proc.get_stderr_pipe())
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_line, stream)
        proc.wait_check_async(None, self.on_finished)
        GLib.timeout_add(1500, self.pulse_copy)

    def pulse_copy(self):
        # The copy is the long stage; creep forward inside its range.
        frac = self.bar.get_fraction()
        if self.current() != "progress":
            return False
        if 0.20 <= frac < 0.74:
            self.bar.set_fraction(frac + 0.004)
        return True

    def on_line(self, stream, result, _data):
        try:
            line, _len = stream.read_line_finish_utf8(result)
        except GLib.Error:
            return
        if line is None:
            return
        buf = self.log_view.get_buffer()
        buf.insert(buf.get_end_iter(), line + "\n")
        msg = line.removeprefix("[voltos-install] ")
        if not msg.startswith("+ "):
            for name, frac in STAGES:
                if msg.startswith(name):
                    self.status.set_label(msg)
                    self.bar.set_fraction(max(frac, self.bar.get_fraction()))
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_line, stream)

    def on_finished(self, proc, result):
        try:
            proc.wait_check_finish(result)
            ok = True
        except GLib.Error:
            ok = False
        if self.config_path:
            try:
                os.unlink(self.config_path)
            except OSError:
                pass
        if TEST_DISK:
            self.test_result("ok" if ok else "failed: voltos-install")
        if ok:
            self.bar.set_fraction(1.0)
            self.done_page.set_description(
                "Remove the installation medium and restart. ZFSBootMenu "
                "starts VoltOS; press Escape at its countdown to choose "
                "another boot environment or a snapshot.")
            self.show_page("done")
        else:
            self.status.set_label("The installation failed. The details "
                                  "below and /var/log/voltos-install.log say "
                                  "why. Nothing has been changed on other "
                                  "disks.")
            self.status.add_css_class("error")


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.props.active_window or Installer(self)
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
