# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>

pkgname=voltos-installer
pkgver=0.4.0
pkgrel=2
pkgdesc="Guided VoltOS installer: ZFS root, boot environments, ZFSBootMenu"
arch=('any')
url="https://github.com/abdonmorales/voltOS"
license=('MIT')
depends=('bash' 'dialog' 'gptfdisk' 'dosfstools' 'parted' 'rsync'
         'arch-install-scripts' 'efibootmgr' 'zfs-utils'
         'util-linux' 'sudo' 'polkit'
         # ZFSBootMenu: zfsbootmenu-efi (x86_64) or zfsbootmenu (AArch64)
         'voltos-zbm')
source=('voltos-install' 'voltos-install-text')
sha256sums=('SKIP' 'SKIP')

package() {
    install -Dm755 voltos-install "${pkgdir}"/usr/bin/voltos-install
    install -Dm755 voltos-install-text "${pkgdir}"/usr/bin/voltos-install-text
}
