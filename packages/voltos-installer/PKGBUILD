# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>

pkgname=voltos-installer
pkgver=0.3.0
pkgrel=1
pkgdesc="Guided VoltOS installer: ZFS root, boot environments, ZFSBootMenu"
arch=('any')
url="https://github.com/abdonmorales/voltOS"
license=('MIT')
depends=('bash' 'dialog' 'gptfdisk' 'dosfstools' 'parted' 'rsync'
         'arch-install-scripts' 'efibootmgr' 'zfs-utils' 'zfsbootmenu-efi'
         'util-linux' 'sudo'
         'python' 'python-gobject' 'gtk4' 'libadwaita' 'polkit')
source=('voltos-install' 'voltos-installer-gtk' 'voltos-install-text'
        'voltos-installer.desktop')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 voltos-install "${pkgdir}"/usr/bin/voltos-install
    install -Dm755 voltos-installer-gtk "${pkgdir}"/usr/bin/voltos-installer-gtk
    install -Dm755 voltos-install-text "${pkgdir}"/usr/bin/voltos-install-text
    install -Dm644 voltos-installer.desktop \
        "${pkgdir}"/usr/share/applications/voltos-installer.desktop
}
