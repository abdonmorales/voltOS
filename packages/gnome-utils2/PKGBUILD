# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>
#
# GNOME Utilities 2.32: the GNOME 2 Screenshot tool, Dictionary, Disk Usage
# Analyzer (Baobab), Search for Files and System Log Viewer (MATE Utilities
# are their fork).  From GNOME's release, for x86_64 and AArch64, without
# their manuals and the dictionary panel applet.  They take the commands of
# their GNOME 3 successors, so they cannot be installed together.

pkgname=gnome-utils2
pkgver=2.32.0
pkgrel=1
pkgdesc="Screenshot, dictionary, disk usage, search and log tools of GNOME 2"
arch=('x86_64' 'aarch64')
url="https://gitlab.gnome.org/Archive/gnome-utils"
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later')
depends=('gtk2' 'gconf' 'glib2' 'libgtop' 'libcanberra-gtk2' 'libsm' 'libxext'
         'libx11' 'zlib')
makedepends=('intltool' 'gtk2' 'gconf' 'libgtop' 'libcanberra-gtk2' 'libsm' 'libice'
             'libxext' 'glib2-devel')
conflicts=('gnome-utils' 'baobab' 'gnome-dictionary' 'gnome-screenshot'
           'gnome-search-tool' 'gnome-system-log')
_domain=gnome-utils
source=("https://download.gnome.org/sources/gnome-utils/${pkgver%.*}/gnome-utils-$pkgver.tar.bz2")
# From GNOME's gnome-utils-2.32.0.sha256sum.
sha256sums=('033a55cf442096b28ea6292043354feafe000d1e5f4ebb962a9b6d72eb9a93fa')

prepare() {
    # The tarball's config.guess and config.sub (2010) predate AArch64;
    # use the build host's current ones.
    local _f
    for _f in config.guess config.sub; do
        find "$srcdir" -name $_f -exec cp -f "$(automake --print-libdir)/$_f" {} \;
    done
    cd gnome-utils-$pkgver
    # Today's glib-mkenums includes the headers in name order, where
    # gdict-client-context.h comes before the gdict-context.h it relies on.
    sed -i 's|^#include <glib-object.h>$|&\n#include "gdict-context.h"|' \
        gnome-dictionary/libgdict/gdict-client-context.h
    # The search tool uses GTK 2 API that GTK 2.24 deprecated
    # (GtkComboBoxEntry): build without hiding the deprecated API.
    find . -name Makefile.in -exec sed -i 's/-D\(GTK\|GDK\|G\)_DISABLE_DEPRECATED//g' {} +
    local _d
    for _d in baobab logview gsearchtool gnome-dictionary; do
        sed -i '/^SUBDIRS = /s/ help\b//' $_d/Makefile.in
    done
}

build() {
    cd gnome-utils-$pkgver
    # gnome-doc-utils (Python 2) is gone: satisfy configure's check with a stub
    # and leave out the help manuals.
    mkdir -p "$srcdir/stub-pc"
    printf 'Name: gnome-doc-utils\nDescription: stub\nVersion: 0.20.10\n' \
        >"$srcdir/stub-pc/gnome-doc-utils.pc"
    export PKG_CONFIG_PATH="$srcdir/stub-pc"
    # -fcommon: Baobab defines its globals in a header (GCC 10 made that an
    # error).
    CFLAGS+=" -std=gnu17 -fpermissive -fcommon"
    export LIBS="-lICE -lX11 -lm"
    export LDFLAGS+=" -Wl,--copy-dt-needed-entries"
    # It insists on scrollkeeper, for the manuals that are left out.
    SCROLLKEEPER_CONFIG=/usr/bin/true \
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --libexecdir=/usr/lib/gnome-utils --disable-static \
        --disable-scrollkeeper --disable-schemas-install --disable-gdict-applet \
        --disable-maintainer-flags
    make
}

package() {
    cd gnome-utils-$pkgver
    make GCONF_DISABLE_MAKEFILE_SCHEMA_INSTALL=1 DESTDIR="$pkgdir" install
    if compgen -G "$pkgdir/etc/gconf/schemas/*.schemas" >/dev/null; then
        install -d "$pkgdir/usr/share/gconf/schemas"
        gconf-merge-schema "$pkgdir/usr/share/gconf/schemas/$pkgname.schemas" \
            --domain "$_domain" "$pkgdir"/etc/gconf/schemas/*.schemas
        rm -f "$pkgdir"/etc/gconf/schemas/*.schemas
    fi
    rmdir -p "$pkgdir/etc/gconf/schemas" 2>/dev/null || :
    # GNOME 2's applications in the GNOME 2 session, MATE's in MATE's
    # (voltos-gnome2 hides MATE's in GNOME 2).
    local _f
    for _f in "$pkgdir"/usr/share/applications/*.desktop; do
        if grep -q '^NotShowIn=' "$_f"; then
            sed -i 's/^NotShowIn=\(.*[^;]\);*$/NotShowIn=\1;MATE;/' "$_f"
        elif ! grep -q '^OnlyShowIn=' "$_f"; then
            sed -i '/^\[Desktop Entry\]$/a NotShowIn=MATE;' "$_f"
        fi
    done
}
