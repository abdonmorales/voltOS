# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>
#
# gtkmm 2.24, the C++ interface to GTK 2 (GNOME 2's System Monitor is
# written with it), which Arch no longer ships.  From GNOME's release, for
# x86_64 and AArch64, without its documentation.  It installs beside
# gtkmm 3 and 4.

pkgname=gtkmm2
pkgver=2.24.5
pkgrel=1
pkgdesc="C++ interface to GTK 2"
arch=('x86_64' 'aarch64')
url="https://www.gtkmm.org"
license=('LGPL-2.1-or-later')
depends=('gtk2' 'glibmm' 'cairomm' 'pangomm' 'atkmm' 'libsigc++')
makedepends=('gtk2' 'glibmm' 'cairomm' 'pangomm' 'atkmm' 'libsigc++')
source=("https://download.gnome.org/sources/gtkmm/${pkgver%.*}/gtkmm-$pkgver.tar.xz")
# From GNOME's gtkmm-2.24.5.sha256sum.
sha256sums=('0680a53b7bf90b4e4bf444d1d89e6df41c777e0bacc96e9c09fc4dd2f5fe6b72')

prepare() {
    # The tarball's config.guess and config.sub predate AArch64; use the
    # build host's current ones.
    local _f
    for _f in config.guess config.sub; do
        find "$srcdir" -name $_f -exec cp -f "$(automake --print-libdir)/$_f" {} \;
    done
}

build() {
    cd gtkmm-$pkgver
    ./configure --prefix=/usr --disable-static --disable-documentation
    make
}

package() {
    cd gtkmm-$pkgver
    make DESTDIR="$pkgdir" install
}
