# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>
#
# GNOME Power Manager 2.32, GNOME 2's power management: battery, AC and
# lid policy, display brightness and blanking, suspend and hibernate,
# warnings, and power statistics (MATE's is its fork).  From GNOME's
# release, for x86_64 and AArch64, on logind and today's UPower (0001),
# without its manual and panel applets.  It takes GNOME Power Manager 3's
# commands, so the two cannot be installed together.

pkgname=gnome-power-manager2
pkgver=2.32.0
pkgrel=1
pkgdesc="Power management of GNOME 2"
arch=('x86_64' 'aarch64')
url="https://gitlab.gnome.org/GNOME/gnome-power-manager"
license=('GPL-2.0-or-later')
depends=('gtk2' 'gconf' 'glib2' 'dbus-glib' 'upower' 'libnotify' 'libunique'
         'libgnome-keyring' 'libwnck' 'libcanberra-gtk2' 'libxrandr' 'cairo'
         'polkit' 'systemd')
makedepends=('intltool' 'gtk2' 'gconf' 'dbus-glib' 'upower' 'libnotify' 'libunique'
             'libgnome-keyring' 'libwnck' 'libcanberra-gtk2' 'libxrandr' 'glib2-devel')
conflicts=('gnome-power-manager')
_domain=gnome-power-manager
source=("https://download.gnome.org/sources/gnome-power-manager/${pkgver%.*}/gnome-power-manager-$pkgver.tar.bz2"
        '0001-logind-and-upower-0.99.patch')
# The tarball's from GNOME's gnome-power-manager-2.32.0.sha256sum.
sha256sums=('17fa301bf7e133285c0e054ae3be2b0f690c48f59b09f67e04d6ed339b330476'
            'SKIP')

prepare() {
    # The tarball's config.guess and config.sub (2010) predate AArch64;
    # use the build host's current ones.
    local _f
    for _f in config.guess config.sub; do
        find "$srcdir" -name $_f -exec cp -f "$(automake --print-libdir)/$_f" {} \;
    done
    cd gnome-power-manager-$pkgver
    patch -Np1 -i ../0001-logind-and-upower-0.99.patch
    sed -i 's/^SUBDIRS = src po docs man data help policy tools/SUBDIRS = src po man data policy tools/' Makefile.in
}

build() {
    cd gnome-power-manager-$pkgver
    # gnome-doc-utils (Python 2) is gone: satisfy configure's check with a stub
    # and leave out the help manual.
    mkdir -p "$srcdir/stub-pc"
    printf 'Name: gnome-doc-utils\nDescription: stub\nVersion: 0.20.10\n' \
        >"$srcdir/stub-pc/gnome-doc-utils.pc"
    export PKG_CONFIG_PATH="$srcdir/stub-pc"
    CFLAGS+=" -std=gnu17 -fpermissive -Wno-error"
    export LDFLAGS+=" -Wl,--copy-dt-needed-entries"
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --libexecdir=/usr/lib/gnome-power-manager --disable-scrollkeeper \
        --disable-schemas-install --disable-applets --disable-tests \
        --disable-strict --disable-docbook-docs
    make
}

package() {
    cd gnome-power-manager-$pkgver
    make GCONF_DISABLE_MAKEFILE_SCHEMA_INSTALL=1 DESTDIR="$pkgdir" install
    if compgen -G "$pkgdir/etc/gconf/schemas/*.schemas" >/dev/null; then
        install -d "$pkgdir/usr/share/gconf/schemas"
        gconf-merge-schema "$pkgdir/usr/share/gconf/schemas/$pkgname.schemas" \
            --domain "$_domain" "$pkgdir"/etc/gconf/schemas/*.schemas
        rm -f "$pkgdir"/etc/gconf/schemas/*.schemas
    fi
    rmdir -p "$pkgdir/etc/gconf/schemas" 2>/dev/null || :
    # GNOME 2's applications in the GNOME 2 session, MATE's in MATE's
    # (voltos-gnome2 hides MATE's in GNOME 2).
    local _f
    for _f in "$pkgdir"/usr/share/applications/*.desktop; do
        if grep -q '^NotShowIn=' "$_f"; then
            sed -i 's/^NotShowIn=\(.*[^;]\);*$/NotShowIn=\1;MATE;/' "$_f"
        elif ! grep -q '^OnlyShowIn=' "$_f"; then
            sed -i '/^\[Desktop Entry\]$/a NotShowIn=MATE;' "$_f"
        fi
    done
}
