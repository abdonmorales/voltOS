diff -ruN gnome-power-manager-2.32.0.orig/src/up-wakeups-compat.h gnome-power-manager-2.32.0/src/up-wakeups-compat.h
--- gnome-power-manager-2.32.0.orig/src/up-wakeups-compat.h	1970-01-01 00:00:00.000000000 +0000
+++ gnome-power-manager-2.32.0/src/up-wakeups-compat.h	2026-11-16 00:37:46.371733756 +0000
@@ -0,0 +1,25 @@
+/*
+ * VoltOS: UPower 0.99 dropped its processor wakeup statistics (UpWakeups).
+ * These stand-ins report that the capability is missing, so the statistics
+ * window leaves out its "Processor" page.
+ */
+#ifndef UP_WAKEUPS_COMPAT_H
+#define UP_WAKEUPS_COMPAT_H
+
+#include <glib.h>
+
+typedef struct _UpWakeups UpWakeups;
+typedef struct _UpWakeupItem UpWakeupItem;
+
+static inline UpWakeups *up_wakeups_new (void) { return NULL; }
+static inline gboolean up_wakeups_get_has_capability (UpWakeups *w) { return FALSE; }
+static inline guint up_wakeups_get_total_sync (UpWakeups *w, GCancellable *c, GError **e)
+{ g_set_error_literal (e, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED, "not supported"); return 0; }
+static inline GPtrArray *up_wakeups_get_data_sync (UpWakeups *w, GCancellable *c, GError **e) { return NULL; }
+static inline const gchar *up_wakeup_item_get_cmdline (UpWakeupItem *i) { return NULL; }
+static inline const gchar *up_wakeup_item_get_details (UpWakeupItem *i) { return NULL; }
+static inline guint up_wakeup_item_get_id (UpWakeupItem *i) { return 0; }
+static inline gboolean up_wakeup_item_get_is_userspace (UpWakeupItem *i) { return FALSE; }
+static inline gdouble up_wakeup_item_get_value (UpWakeupItem *i) { return 0; }
+
+#endif
