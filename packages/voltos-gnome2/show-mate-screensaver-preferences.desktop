[Desktop Entry]
# MATE's settings for the volume, power and screensaver daemons GNOME 2
# uses: in GNOME 2's System > Preferences too.  OnlyShowIn=MATE dropped.
Name=Screensaver
Comment=Set your screensaver preferences
Icon=preferences-desktop-screensaver
Exec=mate-screensaver-preferences
Terminal=false
Type=Application
Categories=GTK;Settings;DesktopSettings;
Keywords=MATE;screensaver;preferences;
StartupNotify=true
