# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>
#
# The GNOME 2.32 desktop on VoltOS: depends on the whole desktop and sets
# VoltOS's defaults for it in GConf (Nimbus theme, icons and window frames;
# the OpenSolaris-style blue gradient; desktop icons), as voltos-desktop
# does for MATE.  "GNOME 2.32" appears in LightDM's session list.
#
# In the GNOME 2 session, GNOME 2's applications are the defaults (Nautilus,
# GNOME Terminal, gedit, Eye of GNOME, Evince, File Roller, gcalctool, System
# Monitor, GNOME Utilities) and MATE's counterparts are left out of the menus
# (see gnome2-session); in MATE, GNOME 2's are.  MATE's own volume control,
# power manager and screensaver run in GNOME 2 too.
#
# GNOME 2's window manager, panel and session take the commands GNOME
# Flashback uses, so the two cannot be installed together; GNOME 2 is
# planned to replace Flashback as VoltOS's second session around 1.5.

pkgname=voltos-gnome2
pkgver=2026.11
pkgrel=2
pkgdesc="GNOME 2.32 desktop with VoltOS's defaults (Nimbus)"
arch=('any')
url="https://github.com/abdonmorales/voltOS"
license=('MIT')
depends=('gnome-session2' 'gnome-settings-daemon2' 'metacity2' 'gnome-panel2'
         'nautilus2' 'gnome-terminal2' 'gnome-control-center2'
         'gtk-engine-nimbus' 'nimbus-gtk-theme' 'voltos-branding' 'gconf'
         'gnome-keyring' 'polkit-gnome' 'xdg-desktop-portal-gtk'
         'gedit2' 'eog2' 'evince2' 'file-roller2' 'gcalctool2' 'gnome-system-monitor2'
         'gnome-utils2'
         'network-manager-applet' 'mate-media' 'mate-power-manager' 'mate-screensaver')
# Replaces GNOME Flashback: pacman offers to remove it along with the GNOME 3
# programs GNOME 2 takes the place of (metacity, gnome-panel, gnome-session,
# gnome-settings-daemon, nautilus; each GNOME 2 package declares its own), and
# GNOME 3's desktop portal, which needs GNOME 3's Nautilus.
conflicts=('gnome-flashback' 'xdg-desktop-portal-gnome')
install=voltos-gnome2.install
source=('voltos-gnome2.entries'
        'gnome2.desktop'
        'gnome2-session'
        'gnome2-mimeapps.list'
        'gnome2-portals.conf'
        'nm-applet.desktop'
        'hide-mate-terminal.desktop'
        'hide-caja-browser.desktop'
        'hide-mate-font-viewer.desktop'
        'hide-pluma.desktop'
        'hide-eom.desktop'
        'hide-atril.desktop'
        'hide-engrampa.desktop'
        'hide-mate-calc.desktop'
        'hide-mate-system-monitor.desktop'
        'hide-mate-dictionary.desktop'
        'hide-mate-disk-usage-analyzer.desktop'
        'hide-mate-search-tool.desktop'
        'hide-mate-system-log.desktop'
        'show-mate-volume-control.desktop'
        'show-mate-power-preferences.desktop'
        'show-mate-power-statistics.desktop'
        'show-mate-screensaver-preferences.desktop'
        'autostart-mate-volume-control-status-icon.desktop'
        'autostart-mate-power-manager.desktop'
        'autostart-mate-screensaver.desktop'
        'gnome-screensaver-command'
        'gnome-screensaver-preferences')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm644 voltos-gnome2.entries "$pkgdir/usr/share/voltos-gnome2/voltos-gnome2.entries"

    # The session (gnome-session2 installs none): GNOME 2's applications as
    # the defaults in it, through the directories gnome2-session puts
    # first in the XDG search paths.
    install -Dm644 gnome2.desktop "$pkgdir/usr/share/xsessions/gnome2.desktop"
    install -Dm755 gnome2-session "$pkgdir/usr/lib/voltos-gnome2/gnome2-session"
    local apps=$pkgdir/usr/share/voltos-gnome2/applications id
    install -Dm644 gnome2-mimeapps.list "$apps/gnome2-mimeapps.list"
    local f
    for f in hide-*.desktop show-*.desktop; do
        install -Dm644 "$f" "$apps/${f#*-}"
    done
    local auto=$pkgdir/etc/xdg/voltos-gnome2/autostart
    install -Dm644 nm-applet.desktop "$auto/nm-applet.desktop"
    for f in autostart-*.desktop; do
        install -Dm644 "$f" "$auto/${f#autostart-}"
    done
    install -Dm755 gnome-screensaver-command gnome-screensaver-preferences \
        -t "$pkgdir/usr/lib/voltos-gnome2/bin"
    install -Dm644 gnome2-portals.conf "$pkgdir/usr/share/xdg-desktop-portal/gnome2-portals.conf"
}
