[Desktop Entry]
# NetworkManager's applet does not start in GNOME (GNOME 3 shows the network
# in its own shell), and GNOME 2.32's session manager counts itself as
# GNOME: in GNOME 2 the panel's notification area shows it.
Name=NetworkManager Applet
Comment=Manage your network connections
Icon=nm-device-wireless
Exec=nm-applet
Terminal=false
Type=Application
NoDisplay=true
X-GNOME-UsesNotifications=true
