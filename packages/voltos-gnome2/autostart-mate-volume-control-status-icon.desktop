[Desktop Entry]
# MATE's, for GNOME 2.32 (its own needs software that is gone): started
# in the GNOME 2 session too.  OnlyShowIn=MATE dropped.
Name=Volume Control
Comment=Show desktop volume control
Icon=multimedia-volume-control
Exec=mate-volume-control-status-icon
Terminal=false
Type=Application
Categories=AudioVideo;Mixer;Settings;HardwareSettings;
Keywords=MATE;volume;control;mixer;settings;sound;
NoDisplay=true
X-MATE-Autostart-Notify=true
