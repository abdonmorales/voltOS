[Desktop Entry]
# MATE's settings for the volume, power and screensaver daemons GNOME 2
# uses: in GNOME 2's System > Preferences too.  OnlyShowIn=MATE dropped.
Name=Power Statistics
Comment=Observe power management
Icon=mate-power-statistics
Exec=mate-power-statistics
Terminal=false
Type=Application
Categories=GTK;System;Monitor;
NoDisplay=false
StartupNotify=true
X-Desktop-File-Install-Version=0.10
