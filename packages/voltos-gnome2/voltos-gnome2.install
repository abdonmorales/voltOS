_entries=usr/share/voltos-gnome2/voltos-gnome2.entries
_defaults=xml:merged:/etc/gconf/gconf.xml.defaults

post_install() {
	usr/bin/gconftool-2 --direct --config-source="$_defaults" --load "$_entries" >/dev/null
}

post_upgrade() {
	post_install
}

pre_remove() {
	usr/bin/gconftool-2 --direct --config-source="$_defaults" --unload "$_entries" \
	    >/dev/null 2>&1 || :
}
