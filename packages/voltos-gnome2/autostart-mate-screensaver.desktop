[Desktop Entry]
# MATE's, for GNOME 2.32 (its own needs software that is gone): started
# in the GNOME 2 session too.  OnlyShowIn=MATE dropped.
Type=Application
Name=Screensaver
Comment=Launch screensaver and locker program
Icon=preferences-desktop-screensaver
Exec=mate-screensaver
NoDisplay=true
Keywords=MATE;screensaver;locker;
X-MATE-Autostart-Phase=Application
X-MATE-Autostart-Notify=true
