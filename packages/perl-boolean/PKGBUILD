# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>
#
# Perl's boolean module, needed by ZFSBootMenu's generate-zbm.  Arch Linux
# and Arch Linux ARM do not package it.

pkgname=perl-boolean
_dist=boolean
pkgver=0.46
pkgrel=1
pkgdesc="Boolean support for Perl"
arch=('any')
url="https://metacpan.org/release/${_dist}"
license=('Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/I/IN/INGY/${_dist}-${pkgver}.tar.gz")
sha256sums=('95c088085c3e83bf680fe6ce16d8264ec26310490f7d1680e416ea7a118f156a')

build() {
    cd ${_dist}-${pkgver}
    PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
    make
}

check() {
    cd ${_dist}-${pkgver}
    make test
}

package() {
    cd ${_dist}-${pkgver}
    make install DESTDIR="${pkgdir}"
}
