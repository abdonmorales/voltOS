# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>
#
# GConf, GNOME 2's configuration database (the libgconf-2 API; 3.2.6 is its
# final release line, with the D-Bus daemon).  Arch Linux dropped it;
# adapted from the AUR recipe (Pierce Thompson, João Figueiredo; Jan de
# Groot), built from the last commit of the archived repository, with its
# patches, schema hooks and helpers, for x86_64 and AArch64.

pkgname=gconf
# Dots, not Arch's "+": GitHub renames release files with "+" in them,
# and pacman then cannot find them.  pacman compares the two as equal.
pkgver=3.2.6.11.g07808097
pkgrel=2
pkgdesc="GNOME 2's configuration database system"
url="https://gitlab.gnome.org/Archive/gconf"
arch=('x86_64' 'aarch64')
license=('LGPL-2.0-only')
depends=('libxml2' 'polkit' 'libldap' 'dbus-glib')
makedepends=('git' 'intltool' 'gtk-doc' 'gobject-introspection' 'gnome-common' 'glib2-devel'
             'libxml2' 'polkit' 'libldap' 'dbus-glib')
install=gconf.install
_commit=0780809731c8ab1c364202b1900d3df106b28626   # the archive's last commit
source=("git+https://gitlab.gnome.org/Archive/gconf.git#commit=$_commit"
        01_xml-gettext-domain.patch gconf-reload.patch
        02-mkdir-with-parents.patch
        gconf-merge-schema gconfpkg gconf-install.hook gconf-remove.hook)
sha256sums=('SKIP'
            'c883dec2b96978874a53700cfe7f26f24f8296767203e970bc6402b4b9945eb8'
            '567b78d8b4b4bbcb77c5f134d57bc503c34867fcc6341c0b01716bcaa4a21694'
            '3a545eb0672d4ad5be731d8b8dfb71a8d73221828cd78ab662a87783ccc6bd87'
            'ee6b6e6f4975dad13a8c45f1c1f0547a99373bdecdcd6604bfc12965c328a028'
            'bf1928718caa5df2b9e54a13cfd0f15a8fe0e09e86b84385ce023616a114e898'
            '2732b2a6b187c5620105a036bde12edee99669605f70cbde56fe5f39619c3dc0'
            '436a65ff290095bc3d35d7d6297cf4d647f61e9f9922cea7ef9f1e251b447ff7')

prepare() {
    cd gconf
    # Fedora: reload gconfd after installing schemas.
    patch -Np1 -i ../gconf-reload.patch
    # https://bugzilla.gnome.org/show_bug.cgi?id=568845
    patch -Np1 -i ../01_xml-gettext-domain.patch
    # VoltOS: create ~/.config/gconf's missing parents (no writable source
    # otherwise on accounts without ~/.config).
    patch -Np1 -i ../02-mkdir-with-parents.patch
    # autogen needs gettext's nls.m4 next to the sources.
    mkdir -p m4
    cp /usr/share/gettext/m4/nls.m4 m4/ 2>/dev/null || cp /usr/share/aclocal/nls.m4 m4/
    NOCONFIGURE=1 ./autogen.sh
}

build() {
    cd gconf
    CFLAGS+=" -std=gnu17"
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --libexecdir=/usr/lib --enable-defaults-service --disable-gtk-doc \
        --disable-static --disable-orbit --disable-gsettings-backend
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
    make CFLAGS+="-DGLIB_DISABLE_DEPRECATION_WARNINGS -Wno-unused-result"
}

package() {
    make -C gconf DESTDIR="$pkgdir" install
    install -d "$pkgdir/etc/gconf/gconf.xml.system"
    install -D gconf-merge-schema gconfpkg -t "$pkgdir/usr/bin"
    install -Dm644 ./*.hook -t "$pkgdir/usr/share/libalpm/hooks"
    # D-Bus policies belong under /usr/share.
    install -Dm644 "$pkgdir/etc/dbus-1/system.d/org.gnome.GConf.Defaults.conf" \
        -t "$pkgdir/usr/share/dbus-1/system.d"
    rm -rf "$pkgdir/etc/dbus-1/"
}
