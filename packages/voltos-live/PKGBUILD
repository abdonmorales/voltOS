# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>
#
# Live-medium only.  The installer removes this package's files from the
# installed system (see /usr/share/voltos/live-files on the ISO).

pkgname=voltos-live
pkgver=0.2.0
pkgrel=5
pkgdesc="VoltOS live session: live user, installer shortcut, unattended install"
arch=('any')
url="https://github.com/abdonmorales/voltOS"
license=('MIT')
depends=('voltos-installer' 'voltos-gui-install' 'voltos-desktop' 'lightdm' 'voltos-doas' 'polkit')
source=('voltos-live-setup' 'voltos-live-setup.service'
        'voltos-autoinstall' 'voltos-autoinstall.service'
        'voltos-live-ready' 'voltos-live-ready.service'
        '95_voltos-live.gschema.override' '49-voltos-live.rules')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 voltos-live-setup "${pkgdir}"/usr/lib/voltos/voltos-live-setup
    install -Dm755 voltos-autoinstall "${pkgdir}"/usr/lib/voltos/voltos-autoinstall
    install -Dm755 voltos-live-ready "${pkgdir}"/usr/lib/voltos/voltos-live-ready
    install -Dm644 voltos-live-ready.service \
        "${pkgdir}"/usr/lib/systemd/system/voltos-live-ready.service
    install -Dm644 voltos-live-setup.service \
        "${pkgdir}"/usr/lib/systemd/system/voltos-live-setup.service
    install -Dm644 voltos-autoinstall.service \
        "${pkgdir}"/usr/lib/systemd/system/voltos-autoinstall.service
    install -Dm644 95_voltos-live.gschema.override \
        "${pkgdir}"/usr/share/glib-2.0/schemas/95_voltos-live.gschema.override
    install -Dm644 49-voltos-live.rules \
        "${pkgdir}"/usr/share/polkit-1/rules.d/49-voltos-live.rules
}
