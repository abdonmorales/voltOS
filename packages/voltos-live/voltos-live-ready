#!/bin/sh
# Report on the first serial port once the display manager has logged the
# live user into a graphical session.  Automated tests (tools/smoke-qemu.sh) wait for
# this line; on machines without a serial port the write simply goes nowhere.
# The first serial port is ttyS0 on PCs and ttyAMA0 (PL011) on 64-bit ARM.
tty=/dev/ttyS0
[ "$(uname -m)" != aarch64 ] || tty=/dev/ttyAMA0
i=0
while [ "$i" -lt 300 ]; do
	for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '$3 == "liveuser" {print $1}'); do
		type=$(loginctl show-session "$s" -p Type --value 2>/dev/null)
		class=$(loginctl show-session "$s" -p Class --value 2>/dev/null)
		if [ "$class" = user ] && { [ "$type" = wayland ] || [ "$type" = x11 ]; }; then
			msg="VOLTOS_LIVE_READY session=$type"
			echo "$msg"
			[ -w "$tty" ] && timeout 5 sh -c "echo '$msg' >$tty" || true
			exit 0
		fi
	done
	sleep 2
	i=$((i + 2))
done
echo "VOLTOS_LIVE_NOT_READY"
[ -w "$tty" ] && timeout 5 sh -c "echo VOLTOS_LIVE_NOT_READY >$tty" || true
exit 1
