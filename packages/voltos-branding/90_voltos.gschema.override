# VoltOS desktop defaults: the Sun/OpenSolaris Nimbus look and feel.
# These org.gnome.desktop keys are read by GNOME Flashback and by GTK
# applications under any desktop; voltos-desktop adds the MATE settings.

[org.gnome.desktop.interface]
gtk-theme='nimbus'
icon-theme='nimbus'
cursor-theme='Adwaita'
color-scheme='default'
accent-color='slate'

[org.gnome.desktop.wm.preferences]
theme='nimbus'
button-layout='appmenu:minimize,maximize,close'
