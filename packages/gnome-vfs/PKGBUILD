# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>
#
# GnomeVFS, the GNOME 2 platform's virtual file system API.  GNOME 2.32's
# file manager and newer applications already use GIO/GVFS; GnomeVFS is
# here for the libraries that still link it (libgnome, libgnomeui).
# Arch Linux dropped it; adapted from the AUR recipe (David McInnis; Jan
# de Groot), with its patches for current GnuTLS and libgcrypt, for x86_64
# and AArch64, and built without Samba, Avahi and FAM, which those
# libraries do not need.

pkgname=gnome-vfs
pkgver=2.24.4
pkgrel=1
pkgdesc="GNOME 2 virtual file system API"
arch=('x86_64' 'aarch64')
url="https://gitlab.gnome.org/Archive/gnome-vfs"
license=('LGPL-2.0-or-later')
depends=('gconf' 'glib2' 'libxml2' 'bzip2' 'zlib' 'gnome-mime-data' 'gnutls'
         'libgcrypt' 'dbus' 'dbus-glib' 'krb5' 'acl' 'util-linux-libs')
makedepends=('pkgconf' 'intltool' 'gtk-doc' 'gnome-common' 'autoconf' 'automake'
             'libtool' 'gconf' 'dbus-glib' 'gnutls' 'libgcrypt' 'gnome-mime-data'
             'krb5')
options=('!emptydirs')
source=("https://download.gnome.org/sources/gnome-vfs/${pkgver%.*}/gnome-vfs-$pkgver.tar.bz2"
        gnutls-config.patch gnutls-3.4.0.patch gcrypt-config.patch
        enable-deprecated.patch)
# The tarball's from GNOME's gnome-vfs-2.24.4.sha256sum.
sha256sums=('62de64b5b804eb04104ff98fcd6a8b7276d510a49fbd9c0feb568f8996444faa'
            '66c7cfb12995c0dd94a2caea95c7e3c55981993f05a79c585d60915ff131955d'
            '5fe5e2e1ad8d8d36deb2d38db621d5b8350aafe3876f722467465c3b3fa304d3'
            'c059e218f310da683778919d36e7862f7e763384805f6453d328fbaf507a8114'
            'ca2b9dffb1fa202c0d1f0d3648ef37cd8e84657a22d4c6746bb46e9a6cf1ee47')

prepare() {
    cd gnome-vfs-$pkgver
    patch -Np1 -i ../gnutls-config.patch     # current GnuTLS
    patch -Np1 -i ../gnutls-3.4.0.patch
    patch -Np1 -i ../gcrypt-config.patch     # libgcrypt >= 1.5
    patch -Np1 -i ../enable-deprecated.patch # no -DG_DISABLE_DEPRECATED
    sed -i 's|$(srcdir)/auto-test|auto-test|' test/Makefile.am
    libtoolize --force
    gtkdocize
    aclocal
    autoconf
    automake --add-missing
}

build() {
    cd gnome-vfs-$pkgver
    CFLAGS+=" -std=gnu17 -fpermissive -fno-strict-aliasing"
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --disable-static --libexecdir=/usr/lib/gnome-vfs-2.0 \
        --disable-samba --disable-avahi --disable-howl --disable-hal \
        --disable-fam --disable-openssl --enable-gnutls
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
    make
}

package() {
    cd gnome-vfs-$pkgver
    make GCONF_DISABLE_MAKEFILE_SCHEMA_INSTALL=1 DESTDIR="$pkgdir" install
    # One merged schema file, installed by gconf's pacman hook.
    install -d "$pkgdir/usr/share/gconf/schemas"
    gconf-merge-schema "$pkgdir/usr/share/gconf/schemas/$pkgname.schemas" \
        --domain gnome-vfs-2.0 "$pkgdir"/etc/gconf/schemas/*.schemas
    rm -f "$pkgdir"/etc/gconf/schemas/*.schemas
}
