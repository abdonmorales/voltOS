# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>
#
# libgnome, the GNOME 2 platform's application library, and its data
# (libgnome-data: schemas, translations).  Arch Linux dropped it; from the
# AUR recipe, with its patches, for x86_64 and AArch64; no ESD sound.

pkgbase=libgnome
pkgname=('libgnome' 'libgnome-data')
pkgver=2.32.1
pkgrel=1
arch=('x86_64' 'aarch64')
url="https://gitlab.gnome.org/Archive/libgnome"
license=('LGPL-2.0-or-later')
makedepends=('intltool' 'gnome-vfs' 'libbonobo' 'gconf' 'gtk-doc' 'gvfs'
             'libcanberra' 'python' 'autoconf' 'automake' 'libtool' 'orbit2'
             'popt' 'glib2-devel')
options=('!emptydirs')
source=("https://download.gnome.org/sources/libgnome/${pkgver%.*}/libgnome-$pkgver.tar.bz2"
        0001-Don-t-use-G_DISABLE_DEPRECATED.patch
        05_glib-2.54-ftbfs.patch)
sha256sums=('b2c63916866485793b87398266dd7778548c1734923c272a94d84ee011b6f7a4'
            'c2521ed5985159b33a0a5bf53b89012abd9521391fc8ce4c9c73289ca18eb147'
            'b86a3a1ef9df2314029a418ea26cadeadb1cf2da30536b850f7c98a6d8ce2220')

prepare() {
    cd libgnome-$pkgver
    patch -Np1 -i ../05_glib-2.54-ftbfs.patch
    patch -Np1 -i ../0001-Don-t-use-G_DISABLE_DEPRECATED.patch
    autoreconf -fi
}

build() {
    cd libgnome-$pkgver
    CFLAGS+=" -std=gnu17 -fpermissive"
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --disable-static --disable-esd
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
    make
}

package_libgnome() {
    pkgdesc="Application library of the GNOME 2 platform"
    depends=("libgnome-data=$pkgver" 'gnome-vfs' 'libbonobo' 'gconf' 'gvfs' 'libcanberra')
    cd libgnome-$pkgver
    make -C libgnome DESTDIR="$pkgdir" install
    make -C monikers DESTDIR="$pkgdir" install
}

package_libgnome-data() {
    pkgdesc="Data of libgnome (GNOME 2 platform)"
    depends=('gconf')
    cd libgnome-$pkgver
    local dir
    for dir in doc gnome-data po schemas; do
        make -C $dir GCONF_DISABLE_MAKEFILE_SCHEMA_INSTALL=1 DESTDIR="$pkgdir" install
    done
    install -d "$pkgdir/usr/share/gconf/schemas"
    gconf-merge-schema "$pkgdir/usr/share/gconf/schemas/libgnome.schemas" \
        --domain libgnome-2.0 "$pkgdir"/etc/gconf/schemas/*.schemas
    rm -f "$pkgdir"/etc/gconf/schemas/*.schemas
}
