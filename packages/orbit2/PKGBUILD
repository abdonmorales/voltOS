# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>
#
# ORBit2, the CORBA ORB under GNOME 2's component system (Bonobo).  Arch
# Linux dropped it; adapted from the AUR recipe (PhotonX; Jan de Groot),
# built from GNOME's final 2.14.19 release for x86_64 and AArch64.

pkgname=orbit2
pkgver=2.14.19
pkgrel=2
pkgdesc="Thin/fast CORBA ORB (GNOME 2 platform)"
arch=('x86_64' 'aarch64')
url="https://gitlab.gnome.org/Archive/orbit2"
license=('LGPL-2.0-or-later' 'GPL-2.0-or-later')
depends=('libidl2' 'glib2')
makedepends=('pkgconf' 'libidl2')
# staticlibs: the naming service library (libname-server-2) only exists
# as a static library, and libbonobo's activation server links it.
options=('!makeflags' 'staticlibs' '!lto')   # !makeflags: the IDL steps are not
# parallel-safe; !lto: a static library built with LTO holds only GCC's
# intermediate code, which libbonobo's link cannot use.
source=("https://download.gnome.org/sources/ORBit2/${pkgver%.*}/ORBit2-$pkgver.tar.bz2")
# From GNOME's ORBit2-2.14.19.sha256sum.
sha256sums=('55c900a905482992730f575f3eef34d50bda717c197c97c08fa5a6eafd857550')

build() {
    cd ORBit2-$pkgver
    # ORBit2 (and its configure tests: "main () { ... }" without a type)
    # predates C23 and GCC 14's stricter defaults; -fpermissive turns those
    # errors back into warnings.
    CFLAGS+=" -std=gnu17 -fpermissive"
    ./configure --prefix=/usr --disable-static
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
    make
}

package() {
    cd ORBit2-$pkgver
    make DESTDIR="$pkgdir" install
    install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
