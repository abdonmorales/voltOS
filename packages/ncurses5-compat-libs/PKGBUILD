# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>
#
# ncurses's libraries with the version 5 ABI (libncursesw.so.5, and
# libtinfo.so.5 / libncurses.so.5 pointing at it), which AMD's Vivado and
# other prebuilt vendor tools still load; Arch ships only version 6.
# Libraries only: no headers, no programs.

pkgname=ncurses5-compat-libs
_pkgname=ncurses
pkgver=6.5
pkgrel=1
pkgdesc="ncurses libraries with the ABI version 5, for prebuilt programs (Vivado)"
arch=('x86_64' 'aarch64')
url="https://invisible-island.net/ncurses/"
license=('MIT')
depends=('glibc' 'gcc-libs')
source=("https://ftp.gnu.org/gnu/ncurses/ncurses-$pkgver.tar.gz")
sha256sums=('136d91bc269a9a5785e5f9e980bc76ab57428f604ce3e5a5a90cebc767971cc6')

build() {
    cd "$_pkgname-$pkgver"
    ./configure --prefix=/usr --mandir=/usr/share/man \
        --with-shared --with-normal --without-debug --without-ada \
        --enable-widec --disable-pc-files --without-cxx-binding \
        --with-versioned-syms --with-abi-version=5 --without-tests --without-progs
    make
}

package() {
    cd "$_pkgname-$pkgver"
    make DESTDIR="$pkgdir" install.libs
    rm -rf "$pkgdir/usr/include" "$pkgdir/usr/lib/pkgconfig" "$pkgdir/usr/bin"
    rm -f "$pkgdir"/usr/lib/*.so "$pkgdir"/usr/lib/*.a
    # Programs linked against the narrow-character libraries get the wide ones.
    local lib
    for lib in ncurses form panel menu; do
        ln -s "lib${lib}w.so.5" "$pkgdir/usr/lib/lib${lib}.so.5"
    done
    ln -s libncursesw.so.5 "$pkgdir/usr/lib/libtinfo.so.5"
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
