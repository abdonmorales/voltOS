+
+/*
+ * The two places where the C++ UNO bridge for Linux AArch64 needs the
+ * registers themselves (AAPCS64).  Both keep a frame pointer and carry
+ * unwind information, because C++ exceptions pass through them.
+ */
+
+	.text
+
+/*
+ * privateSnippetExecutor: where the code snippets of the bridge's vtables
+ * jump to (cpp2uno.cxx).  A snippet loads x9 with
+ * (vtable offset << 32) | function index and branches here, with the
+ * caller's arguments still in x0-x7, v0-v7 and on the stack, and x8
+ * holding the address for an indirect result.  Saves the argument
+ * registers, calls
+ *
+ *   cpp_vtable_call( sal_Int32 nFunctionIndex, sal_Int32 nVtableOffset,
+ *                    void ** gpreg, void ** fpreg, void ** ovrflw,
+ *                    sal_uInt64 * pRegisterReturn, void * pIndirectReturn )
+ *
+ * and returns to the caller with x0, x1 and d0-d3 loaded from
+ * pRegisterReturn.
+ *
+ * Frame (192 bytes): x29, x30 | x0-x7 at 16 | d0-d7 at 80 | return area
+ * (x0, x1, d0-d3) at 144.  The caller's stack arguments are at 192.
+ */
+	.align	2
+	.globl	privateSnippetExecutor
+	.hidden	privateSnippetExecutor
+	.type	privateSnippetExecutor, %function
+privateSnippetExecutor:
+	.cfi_startproc
+	stp	x29, x30, [sp, #-192]!
+	.cfi_def_cfa_offset 192
+	.cfi_offset 29, -192
+	.cfi_offset 30, -184
+	mov	x29, sp
+	.cfi_def_cfa_register 29
+	stp	x0, x1, [sp, #16]
+	stp	x2, x3, [sp, #32]
+	stp	x4, x5, [sp, #48]
+	stp	x6, x7, [sp, #64]
+	stp	d0, d1, [sp, #80]
+	stp	d2, d3, [sp, #96]
+	stp	d4, d5, [sp, #112]
+	stp	d6, d7, [sp, #128]
+	mov	w0, w9			/* nFunctionIndex */
+	lsr	x1, x9, #32		/* nVtableOffset */
+	add	x2, sp, #16		/* gpreg */
+	add	x3, sp, #80		/* fpreg */
+	add	x4, sp, #192		/* ovrflw */
+	add	x5, sp, #144		/* pRegisterReturn */
+	mov	x6, x8			/* pIndirectReturn */
+	bl	cpp_vtable_call
+	ldp	x0, x1, [sp, #144]
+	ldp	d0, d1, [sp, #160]
+	ldp	d2, d3, [sp, #176]
+	ldp	x29, x30, [sp], #192
+	.cfi_restore 29
+	.cfi_restore 30
+	.cfi_def_cfa 31, 0
+	ret
+	.cfi_endproc
+	.size	privateSnippetExecutor, .-privateSnippetExecutor
+
+/*
+ * void callVirtualMethodImpl( void * pFunction, sal_uInt64 * pGPR,
+ *                             sal_uInt64 * pFPR, sal_uInt64 * pStack,
+ *                             sal_uInt64 nStack, void * pIndirectReturn,
+ *                             sal_uInt64 * pRegisterReturn )
+ *
+ * Calls pFunction with x0-x7 from pGPR[0..7], d0-d7 from pFPR[0..7] (a
+ * float in the low 32 bits), nStack 8-byte stack arguments from pStack and
+ * x8 = pIndirectReturn, and stores x0, x1, d0-d3 in pRegisterReturn[0..5]
+ * (uno2cpp.cxx).
+ */
+	.align	2
+	.globl	callVirtualMethodImpl
+	.hidden	callVirtualMethodImpl
+	.type	callVirtualMethodImpl, %function
+callVirtualMethodImpl:
+	.cfi_startproc
+	stp	x29, x30, [sp, #-32]!
+	.cfi_def_cfa_offset 32
+	.cfi_offset 29, -32
+	.cfi_offset 30, -24
+	mov	x29, sp
+	.cfi_def_cfa_register 29
+	str	x19, [sp, #16]
+	.cfi_offset 19, -16
+	mov	x19, x6			/* pRegisterReturn, kept across the call */
+	mov	x16, x0			/* pFunction */
+	mov	x13, x1			/* pGPR */
+	mov	x14, x2			/* pFPR */
+	/* Stack arguments: nStack 8-byte slots, sp kept 16-byte aligned. */
+	add	x10, x4, #1
+	and	x10, x10, #~1
+	lsl	x10, x10, #3
+	sub	sp, sp, x10
+	mov	x11, #0
+1:	cmp	x11, x4
+	b.hs	2f
+	ldr	x12, [x3, x11, lsl #3]
+	str	x12, [sp, x11, lsl #3]
+	add	x11, x11, #1
+	b	1b
+2:	mov	x8, x5			/* indirect result */
+	ldp	d0, d1, [x14]
+	ldp	d2, d3, [x14, #16]
+	ldp	d4, d5, [x14, #32]
+	ldp	d6, d7, [x14, #48]
+	ldp	x0, x1, [x13]
+	ldp	x2, x3, [x13, #16]
+	ldp	x4, x5, [x13, #32]
+	ldp	x6, x7, [x13, #48]
+	blr	x16
+	stp	x0, x1, [x19]
+	stp	d0, d1, [x19, #16]
+	stp	d2, d3, [x19, #32]
+	mov	sp, x29
+	ldr	x19, [sp, #16]
+	ldp	x29, x30, [sp], #32
+	.cfi_restore 19
+	.cfi_restore 29
+	.cfi_restore 30
+	.cfi_def_cfa 31, 0
+	ret
+	.cfi_endproc
+	.size	callVirtualMethodImpl, .-callVirtualMethodImpl
+
+	.section .note.GNU-stack, "", %progbits
