+ *************************************************************/
+
+#ifndef _BRIDGES_CPP_UNO_AARCH64_ABI_HXX_
+#define _BRIDGES_CPP_UNO_AARCH64_ABI_HXX_
+
+// The parts of the Procedure Call Standard for the ARM 64-bit Architecture
+// (AAPCS64) that the C++ UNO bridge needs, as GCC implements it on Linux.
+//
+// In the UNO C++ language binding only simple types (integers, enums,
+// float, double) are passed by value; everything else is passed by
+// reference, i.e. as a pointer.  So arguments are either an integer or
+// pointer (x0-x7, then the stack) or a float or double (v0-v7, then the
+// stack); each stack argument takes an 8-byte slot.  "this" is always x0:
+// unlike x86-64, an indirect result is addressed by x8, not by a hidden
+// first argument.
+//
+// Return values are classified by getReturnKind().
+
+#include "typelib/typedescription.h"
+
+namespace aarch64
+{
+
+enum
+{
+    MAX_GPR_REGS = 8, // x0-x7
+    MAX_FPR_REGS = 8  // v0-v7
+};
+
+enum ReturnKind
+{
+    RETURN_KIND_REG,        // in x0 (and x1): integers, enums, small structs
+    RETURN_KIND_HFA_FLOAT,  // in s0-s3: float, or a struct of 1-4 floats
+    RETURN_KIND_HFA_DOUBLE, // in d0-d3: double, or a struct of 1-4 doubles
+    RETURN_KIND_INDIRECT    // in memory addressed by x8: everything else
+};
+
+// The register area the assembler code fills from, or stores, the
+// registers a value is returned in: x0, x1, d0, d1, d2, d3.
+enum
+{
+    RETURN_SLOT_X0 = 0,
+    RETURN_SLOT_D0 = 2,
+    RETURN_SLOTS = 6
+};
+
+ReturnKind getReturnKind( typelib_TypeDescription * pTypeDescr );
+
+// Number of elements of a homogeneous floating-point aggregate (HFA)
+// return kind: 1 for float and double.
+sal_Int32 getHfaCount( typelib_TypeDescription * pTypeDescr );
+
+// Copy a return value of the given kind between the register area
+// (RETURN_SLOTS 64-bit slots) and the value in memory.
+void fillReturnRegisters( typelib_TypeDescription * pTypeDescr, ReturnKind eKind,
+                          void const * pValue, sal_uInt64 * pRegisters );
+void readReturnRegisters( typelib_TypeDescription * pTypeDescr, ReturnKind eKind,
+                          sal_uInt64 const * pRegisters, void * pValue );
+
+} // namespace aarch64
+
+#endif
