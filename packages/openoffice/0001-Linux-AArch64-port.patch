+//==================================================================================================
+extern "C" void privateSnippetExecutor( ... );
+
+const int codeSnippetSize = 32;
+
+// Generate a trampoline that redirects method calls to
+// privateSnippetExecutor() (call.s):
+//
+//      ldr  x9, 1f     ; (nVtableOffset << 32) | nFunctionIndex
+//      ldr  x10, 2f    ; privateSnippetExecutor
+//      br   x10
+//      nop
+//  1:  .quad nOffsetAndIndex
+//  2:  .quad privateSnippetExecutor
+//
+// x9 and x10 are scratch registers that carry no arguments; x8 (the
+// indirect result address) is left alone.  The snippet builds no frame
+// and is branched through, not called, so it needs no unwind information.
+static unsigned char * codeSnippet( unsigned char * code,
+        sal_Int32 nFunctionIndex, sal_Int32 nVtableOffset ) SAL_THROW( () )
+{
+	sal_uInt64 nOffsetAndIndex = ( ( (sal_uInt64) nVtableOffset ) << 32 ) | ( (sal_uInt64)(sal_uInt32) nFunctionIndex );
+	sal_uInt32 * p = reinterpret_cast<sal_uInt32 *>( code );
+	p[0] = 0x58000089;	// ldr x9, .+16
+	p[1] = 0x580000aa;	// ldr x10, .+20
+	p[2] = 0xd61f0140;	// br x10
+	p[3] = 0xd503201f;	// nop
+	*reinterpret_cast<sal_uInt64 *>( code + 16 ) = nOffsetAndIndex;
+	*reinterpret_cast<sal_uInt64 *>( code + 24 ) = reinterpret_cast<sal_uInt64>( privateSnippetExecutor );
+	return code + codeSnippetSize;
+}
+
+//==================================================================================================
+struct bridges::cpp_uno::shared::VtableFactory::Slot { void * fn; };
+
+bridges::cpp_uno::shared::VtableFactory::Slot *
+bridges::cpp_uno::shared::VtableFactory::mapBlockToVtable(void * block)
+{
+    return static_cast< Slot * >(block) + 2;
+}
+
+//==================================================================================================
+sal_Size bridges::cpp_uno::shared::VtableFactory::getBlockSize(
+    sal_Int32 slotCount)
+{
+    return (slotCount + 2) * sizeof (Slot) + slotCount * codeSnippetSize;
+}
+
+//==================================================================================================
+bridges::cpp_uno::shared::VtableFactory::Slot *
+bridges::cpp_uno::shared::VtableFactory::initializeBlock(
+    void * block, sal_Int32 slotCount)
+{
+    Slot * slots = mapBlockToVtable(block);
+    slots[-2].fn = 0;
+    slots[-1].fn = 0;
+    return slots + slotCount;
+}
+
+//==================================================================================================
+
+unsigned char * bridges::cpp_uno::shared::VtableFactory::addLocalFunctions(
+	Slot ** slots, unsigned char * code, sal_PtrDiff writetoexecdiff,
+	typelib_InterfaceTypeDescription const * type, sal_Int32 nFunctionOffset,
+	sal_Int32 functionCount, sal_Int32 nVtableOffset )
+{
+	(*slots) -= functionCount;
+	Slot * s = *slots;
+	for ( sal_Int32 nPos = 0; nPos < type->nMembers; ++nPos )
+	{
+		typelib_TypeDescription * pTD = 0;
+
+		TYPELIB_DANGER_GET( &pTD, type->ppMembers[ nPos ] );
+		OSL_ASSERT( pTD );
+
+		if ( typelib_TypeClass_INTERFACE_ATTRIBUTE == pTD->eTypeClass )
+		{
+			typelib_InterfaceAttributeTypeDescription *pAttrTD =
+				reinterpret_cast<typelib_InterfaceAttributeTypeDescription *>( pTD );
+
+			// get method
+			(s++)->fn = code + writetoexecdiff;
+			code = codeSnippet( code, nFunctionOffset++, nVtableOffset );
+
+			if ( ! pAttrTD->bReadOnly )
+			{
+				// set method
+				(s++)->fn = code + writetoexecdiff;
+				code = codeSnippet( code, nFunctionOffset++, nVtableOffset );
+			}
+		}
+		else if ( typelib_TypeClass_INTERFACE_METHOD == pTD->eTypeClass )
+		{
+			(s++)->fn = code + writetoexecdiff;
+			code = codeSnippet( code, nFunctionOffset++, nVtableOffset );
+		}
+		else
+			OSL_ASSERT( false );
+
+		TYPELIB_DANGER_RELEASE( pTD );
+	}
+	return code;
+}
+
+//==================================================================================================
+void bridges::cpp_uno::shared::VtableFactory::flushCode(
+	unsigned char const * begin, unsigned char const * end )
+{
+	// The snippets are only data until the data cache is cleaned and the
+	// instruction cache invalidated, which (unlike on x86) is not
+	// automatic.  With USE_DOUBLE_MMAP these are the writable addresses;
+	// both views map the same memory, and AArch64 caches behave as
+	// physically indexed for this purpose.
+	__builtin___clear_cache( reinterpret_cast<char *>( const_cast<unsigned char *>( begin ) ),
+							 reinterpret_cast<char *>( const_cast<unsigned char *>( end ) ) );
+}
