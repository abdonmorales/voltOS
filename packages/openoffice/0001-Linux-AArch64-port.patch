+
+// MARKER(update_precomp.py): autogen include statement, do not remove
+#include "precompiled_bridges.hxx"
+
+#include <string.h>
+
+#include "abi.hxx"
+
+namespace
+{
+
+// Count the leaf members of a type: floats, doubles and others (integers,
+// enums); bNonTrivial is set when it holds a type that is a class with a
+// non-trivial copy constructor or destructor in C++ (string, type, any,
+// sequence, interface), which AAPCS64 always returns in memory.
+void countMembers( typelib_TypeDescriptionReference * pTypeRef,
+                   sal_Int32 & nFloat, sal_Int32 & nDouble, sal_Int32 & nOther,
+                   bool & bNonTrivial )
+{
+    switch ( pTypeRef->eTypeClass )
+    {
+    case typelib_TypeClass_FLOAT:
+        ++nFloat;
+        break;
+    case typelib_TypeClass_DOUBLE:
+        ++nDouble;
+        break;
+    case typelib_TypeClass_BOOLEAN:
+    case typelib_TypeClass_BYTE:
+    case typelib_TypeClass_SHORT:
+    case typelib_TypeClass_UNSIGNED_SHORT:
+    case typelib_TypeClass_LONG:
+    case typelib_TypeClass_UNSIGNED_LONG:
+    case typelib_TypeClass_HYPER:
+    case typelib_TypeClass_UNSIGNED_HYPER:
+    case typelib_TypeClass_CHAR:
+    case typelib_TypeClass_ENUM:
+        ++nOther;
+        break;
+    case typelib_TypeClass_STRUCT:
+    case typelib_TypeClass_EXCEPTION:
+    {
+        typelib_TypeDescription * pTypeDescr = 0;
+        TYPELIB_DANGER_GET( &pTypeDescr, pTypeRef );
+        typelib_CompoundTypeDescription * pCompTD =
+            reinterpret_cast< typelib_CompoundTypeDescription * >( pTypeDescr );
+        for ( ; pCompTD; pCompTD = pCompTD->pBaseTypeDescription )
+            for ( sal_Int32 i = 0; i < pCompTD->nMembers; ++i )
+                countMembers( pCompTD->ppTypeRefs[i], nFloat, nDouble, nOther, bNonTrivial );
+        TYPELIB_DANGER_RELEASE( pTypeDescr );
+        break;
+    }
+    default:
+        bNonTrivial = true;
+        break;
+    }
+}
+
+}
+
+namespace aarch64
+{
+
+ReturnKind getReturnKind( typelib_TypeDescription * pTypeDescr )
+{
+    switch ( pTypeDescr->eTypeClass )
+    {
+    case typelib_TypeClass_VOID:
+    case typelib_TypeClass_BOOLEAN:
+    case typelib_TypeClass_BYTE:
+    case typelib_TypeClass_SHORT:
+    case typelib_TypeClass_UNSIGNED_SHORT:
+    case typelib_TypeClass_LONG:
+    case typelib_TypeClass_UNSIGNED_LONG:
+    case typelib_TypeClass_HYPER:
+    case typelib_TypeClass_UNSIGNED_HYPER:
+    case typelib_TypeClass_CHAR:
+    case typelib_TypeClass_ENUM:
+        return RETURN_KIND_REG;
+    case typelib_TypeClass_FLOAT:
+        return RETURN_KIND_HFA_FLOAT;
+    case typelib_TypeClass_DOUBLE:
+        return RETURN_KIND_HFA_DOUBLE;
+    case typelib_TypeClass_STRUCT:
+    case typelib_TypeClass_EXCEPTION:
+    {
+        sal_Int32 nFloat = 0, nDouble = 0, nOther = 0;
+        bool bNonTrivial = false;
+        typelib_CompoundTypeDescription * pCompTD =
+            reinterpret_cast< typelib_CompoundTypeDescription * >( pTypeDescr );
+        for ( ; pCompTD; pCompTD = pCompTD->pBaseTypeDescription )
+            for ( sal_Int32 i = 0; i < pCompTD->nMembers; ++i )
+                countMembers( pCompTD->ppTypeRefs[i], nFloat, nDouble, nOther, bNonTrivial );
+        if ( bNonTrivial )
+            return RETURN_KIND_INDIRECT;
+        // A homogeneous floating-point aggregate of up to four members
+        // comes back in v0-v3, whatever its size.
+        if ( nOther == 0 && nDouble == 0 && nFloat >= 1 && nFloat <= 4 )
+            return RETURN_KIND_HFA_FLOAT;
+        if ( nOther == 0 && nFloat == 0 && nDouble >= 1 && nDouble <= 4 )
+            return RETURN_KIND_HFA_DOUBLE;
+        // Other composites of up to 16 bytes come back in x0 and x1.
+        return pTypeDescr->nSize <= 16 ? RETURN_KIND_REG : RETURN_KIND_INDIRECT;
+    }
+    default: // string, type, any, sequence, interface
+        return RETURN_KIND_INDIRECT;
+    }
+}
+
+sal_Int32 getHfaCount( typelib_TypeDescription * pTypeDescr )
+{
+    if ( pTypeDescr->eTypeClass == typelib_TypeClass_FLOAT
+         || pTypeDescr->eTypeClass == typelib_TypeClass_DOUBLE )
+        return 1;
+    sal_Int32 nFloat = 0, nDouble = 0, nOther = 0;
+    bool bNonTrivial = false;
+    typelib_CompoundTypeDescription * pCompTD =
+        reinterpret_cast< typelib_CompoundTypeDescription * >( pTypeDescr );
+    for ( ; pCompTD; pCompTD = pCompTD->pBaseTypeDescription )
+        for ( sal_Int32 i = 0; i < pCompTD->nMembers; ++i )
+            countMembers( pCompTD->ppTypeRefs[i], nFloat, nDouble, nOther, bNonTrivial );
+    return nFloat + nDouble;
+}
+
+void fillReturnRegisters( typelib_TypeDescription * pTypeDescr, ReturnKind eKind,
+                          void const * pValue, sal_uInt64 * pRegisters )
+{
+    memset( pRegisters, 0, RETURN_SLOTS * sizeof (sal_uInt64) );
+    char const * p = static_cast< char const * >( pValue );
+    switch ( eKind )
+    {
+    case RETURN_KIND_REG:
+        if ( pTypeDescr->nSize > 0 )
+            memcpy( pRegisters + RETURN_SLOT_X0, p, pTypeDescr->nSize );
+        break;
+    case RETURN_KIND_HFA_FLOAT:
+        // Each float goes in the low 32 bits of its own register (s0-s3).
+        for ( sal_Int32 i = 0, n = getHfaCount( pTypeDescr ); i < n; ++i )
+            memcpy( pRegisters + RETURN_SLOT_D0 + i, p + 4 * i, 4 );
+        break;
+    case RETURN_KIND_HFA_DOUBLE:
+        for ( sal_Int32 i = 0, n = getHfaCount( pTypeDescr ); i < n; ++i )
+            memcpy( pRegisters + RETURN_SLOT_D0 + i, p + 8 * i, 8 );
+        break;
+    case RETURN_KIND_INDIRECT:
+        break;
+    }
+}
+
+void readReturnRegisters( typelib_TypeDescription * pTypeDescr, ReturnKind eKind,
+                          sal_uInt64 const * pRegisters, void * pValue )
+{
+    char * p = static_cast< char * >( pValue );
+    switch ( eKind )
+    {
+    case RETURN_KIND_REG:
+        if ( pTypeDescr->nSize > 0 )
+            memcpy( p, pRegisters + RETURN_SLOT_X0, pTypeDescr->nSize );
+        break;
+    case RETURN_KIND_HFA_FLOAT:
+        for ( sal_Int32 i = 0, n = getHfaCount( pTypeDescr ); i < n; ++i )
+            memcpy( p + 4 * i, pRegisters + RETURN_SLOT_D0 + i, 4 );
+        break;
+    case RETURN_KIND_HFA_DOUBLE:
+        for ( sal_Int32 i = 0, n = getHfaCount( pTypeDescr ); i < n; ++i )
+            memcpy( p + 8 * i, pRegisters + RETURN_SLOT_D0 + i, 8 );
+        break;
+    case RETURN_KIND_INDIRECT:
+        break;
+    }
+}
+
+} // namespace aarch64
