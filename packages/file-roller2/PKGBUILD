# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>
#
# File Roller 2.32, the GNOME 2 archive manager (MATE's Engrampa is its
# fork).  From GNOME's release, for x86_64 and AArch64, without its manual
# and its Nautilus context-menu extension.  It takes File Roller 3's
# commands, so the two cannot be installed together.

pkgname=file-roller2
pkgver=2.32.2
pkgrel=1
pkgdesc="Archive manager of GNOME 2"
arch=('x86_64' 'aarch64')
url="https://gitlab.gnome.org/GNOME/file-roller"
license=('GPL-2.0-or-later')
depends=('gtk2' 'gconf' 'glib2' 'libsm' 'hicolor-icon-theme')
optdepends=('p7zip: 7z, ARJ, CAB, ISO, and more'
            'unrar: RAR archives'
            'zip: ZIP archives (create)'
            'unzip: ZIP archives (extract)'
            'cpio: cpio and RPM archives'
            'lrzip: lrzip archives'
            'lzop: lzop archives')
makedepends=('intltool' 'gtk2' 'gconf' 'libsm' 'glib2-devel')
conflicts=('file-roller')
_domain=file-roller
source=("https://download.gnome.org/sources/file-roller/${pkgver%.*}/file-roller-$pkgver.tar.bz2")
# From GNOME's file-roller-2.32.2.sha256sum.
sha256sums=('3ddbe4e4134eab4ff8e97789a1626aec6cbc588190f2f520850d0697037e5755')

prepare() {
    # The tarball's config.guess and config.sub (2010) predate AArch64;
    # use the build host's current ones.
    local _f
    for _f in config.guess config.sub; do
        find "$srcdir" -name $_f -exec cp -f "$(automake --print-libdir)/$_f" {} \;
    done
    cd file-roller-$pkgver
    sed -i '/^\thelp\t*\\$/d' Makefile.in
    # GLib has had its own g_ptr_array_copy since 2.62.
    grep -rl g_ptr_array_copy src | xargs sed -i 's/\bg_ptr_array_copy\b/fr_ptr_array_copy/g'
}

build() {
    cd file-roller-$pkgver
    # gnome-doc-utils (Python 2) is gone: satisfy configure's check with a stub
    # and leave out the help manual.
    mkdir -p "$srcdir/stub-pc"
    printf 'Name: gnome-doc-utils\nDescription: stub\nVersion: 0.20.10\n' \
        >"$srcdir/stub-pc/gnome-doc-utils.pc"
    export PKG_CONFIG_PATH="$srcdir/stub-pc"
    CFLAGS+=" -std=gnu17 -fpermissive"
    export LDFLAGS+=" -Wl,--copy-dt-needed-entries"
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --libexecdir=/usr/lib/file-roller --with-gtk=2.0 \
        --disable-scrollkeeper --disable-schemas-install \
        --disable-nautilus-actions --disable-packagekit
    make
}

package() {
    cd file-roller-$pkgver
    make GCONF_DISABLE_MAKEFILE_SCHEMA_INSTALL=1 DESTDIR="$pkgdir" install
    if compgen -G "$pkgdir/etc/gconf/schemas/*.schemas" >/dev/null; then
        install -d "$pkgdir/usr/share/gconf/schemas"
        gconf-merge-schema "$pkgdir/usr/share/gconf/schemas/$pkgname.schemas" \
            --domain "$_domain" "$pkgdir"/etc/gconf/schemas/*.schemas
        rm -f "$pkgdir"/etc/gconf/schemas/*.schemas
    fi
    rmdir -p "$pkgdir/etc/gconf/schemas" 2>/dev/null || :
    # GNOME 2's applications in the GNOME 2 session, MATE's in MATE's
    # (voltos-gnome2 hides MATE's in GNOME 2).
    local _f
    for _f in "$pkgdir"/usr/share/applications/*.desktop; do
        if grep -q '^NotShowIn=' "$_f"; then
            sed -i 's/^NotShowIn=\(.*[^;]\);*$/NotShowIn=\1;MATE;/' "$_f"
        elif ! grep -q '^OnlyShowIn=' "$_f"; then
            sed -i '/^\[Desktop Entry\]$/a NotShowIn=MATE;' "$_f"
        fi
    done
}
