# Maintainer: Abdon Morales <abdonm@cs.utexas.edu>
#
# The GTK 2 half of libcanberra (event sounds): libcanberra-gtk and the
# GTK 2 module, which Arch Linux's libcanberra (GTK 3 only) no longer
# builds; Metacity 2, the GNOME 2 settings daemon and control center use
# it.  From the libcanberra 0.30 release, on top of Arch's libcanberra.

pkgname=libcanberra-gtk2
pkgver=0.30
pkgrel=1
pkgdesc="GTK 2 library and module of libcanberra (event sounds)"
arch=('x86_64' 'aarch64')
url="https://0pointer.de/lennart/projects/libcanberra/"
license=('LGPL-2.1-or-later')
depends=('libcanberra' 'gtk2')
makedepends=('gtk2' 'libvorbis' 'libltdl' 'alsa-lib' 'libpulse' 'tdb' 'gtk-doc')
source=("https://0pointer.de/lennart/projects/libcanberra/libcanberra-$pkgver.tar.xz")
sha256sums=('c2b671e67e0c288a69fc33dc1b6f1b534d07882c2aceed37004bf48c601afa72')

build() {
    cd libcanberra-$pkgver
    CFLAGS+=" -std=gnu17 -fpermissive"
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
        --disable-static --enable-gtk --disable-gtk3 --disable-oss \
        --disable-gstreamer --disable-lynx --with-builtin=dso
    make
}

package() {
    cd libcanberra-$pkgver
    make DESTDIR="$srcdir/stage" install
    # Only what Arch's libcanberra lacks: the GTK 2 library, its pkg-config
    # file and the GTK 2 module.
    cd "$srcdir/stage"
    install -d "$pkgdir/usr/lib/pkgconfig"
    cp -a usr/lib/libcanberra-gtk.so* "$pkgdir/usr/lib/"
    cp -a usr/lib/pkgconfig/libcanberra-gtk.pc "$pkgdir/usr/lib/pkgconfig/"
    cp -a usr/lib/gtk-2.0 "$pkgdir/usr/lib/"
}
