# Default applications in the MATE session (XDG_CURRENT_DESKTOP=MATE).
# With the GNOME 2.32 desktop also installed, its applications offer to
# open folders, text, documents, images and archives too: in MATE, MATE's
# do (Caja, Pluma, Atril, Eye of MATE, Engrampa; for images Eye of MATE
# rather than Atril).  A user's own choices come first.
[Default Applications]
inode/directory=caja-folder-handler.desktop
x-directory/normal=caja-folder-handler.desktop
application/x-mate-saved-search=caja-folder-handler.desktop
application/bzip2=engrampa.desktop
application/epub+zip=atril.desktop
application/gzip=engrampa.desktop
application/ico=eom.desktop
application/jar=engrampa.desktop
