##
## Arch Linux repository mirrorlist (VoltOS)
##
## Arch's own pacman-mirrorlist ships every server commented out, for the
## user to pick; VoltOS starts with Arch's geo-routed mirror, which serves
## from a nearby location, and two large mirrors after it.  For a list
## ranked from where you are:
##   doas pacman -S reflector
##   doas reflector --latest 20 --protocol https --sort rate --save /etc/pacman.d/mirrorlist
##

Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirrors.edge.kernel.org/archlinux/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
